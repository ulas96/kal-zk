# Copy to .env. Values must be UNQUOTED — docker --env-file passes quotes through literally, so
# DATABASE_URL="postgres://..." parses fine on your machine and fails inside the container.
#
# Load it with `set -a` or Go sees nothing:  set -a && . ./.env && set +a
#
# pg.ParseURL accepts only sslmode, application_name and connect_timeout. Any other query
# parameter is a startup failure, not a no-op.
#
# With sslmode absent, TLS is on but the certificate is NOT verified. Use verify-full in
# production; disable is for a local container that speaks plain TCP.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Seeds the differential circuit test (tests/zk_harness_test.go). Unset means 20260805.
#
# The test logs the seed it used on every run, including in CI. When it fails, set this to the seed
# it printed and the exact 2000-witness sequence replays — otherwise a soundness failure found by
# one witness out of two thousand is not reproducible.
KAL_ZK_TEST_SEED=20260805
